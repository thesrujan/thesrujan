stage('Build') {
    steps {
        dir('9-Jenkins-Multi-Stage-Pipeline') {
            sh '''
                set -eu
                python3 --version
                python3 -m venv "$WORKSPACE/.venv"
                "$WORKSPACE/.venv/bin/python" -m pip install --upgrade pip
                "$WORKSPACE/.venv/bin/python" -m pip install -r requirements.txt
                "$WORKSPACE/.venv/bin/python" -m compileall -q app.py test_app.py
            '''
        }
    }
}