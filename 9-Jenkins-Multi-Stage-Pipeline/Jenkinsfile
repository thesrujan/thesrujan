pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_PORT = '18080'
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
        VENV_DIR = "${WORKSPACE}/.venv"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating a Python virtual environment and installing dependencies.'
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    sh '''
                        set -eu
                        python3 --version
                        python3 -m venv "$VENV_DIR"
                        "$VENV_DIR/bin/python" -m pip install --upgrade pip
                        "$VENV_DIR/bin/python" -m pip install -r requirements.txt
                        "$VENV_DIR/bin/python" -m compileall -q app.py test_app.py
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests.'
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    sh '''
                        set -eu
                        "$VENV_DIR/bin/python" -m unittest discover -v -s . -p 'test_*.py'
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Copying the application to the mock deployment directory.'
                dir('9-Jenkins-Multi-Stage-Pipeline') {
                    sh '''
                        set -eu
                        if [ -f "$DEPLOY_DIR/app.pid" ]; then
                            old_pid=$(cat "$DEPLOY_DIR/app.pid" || true)
                            if [ -n "$old_pid" ]; then
                                kill "$old_pid" 2>/dev/null || true
                            fi
                        fi
                        rm -rf "$DEPLOY_DIR"
                        mkdir -p "$DEPLOY_DIR"
                        cp app.py requirements.txt "$DEPLOY_DIR/"
                        echo "Application deployed to $DEPLOY_DIR"
                        ls -l "$DEPLOY_DIR"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the Flask app in the Jenkins agent for verification.'
                sh '''
                    set -eu
                    cd "$DEPLOY_DIR"
                    APP_PORT="$APP_PORT" nohup "$VENV_DIR/bin/python" app.py > app.log 2>&1 &
                    echo $! > app.pid
                    for attempt in $(seq 1 20); do
                        if "$VENV_DIR/bin/python" -c 'import urllib.request; urllib.request.urlopen("http://127.0.0.1:18080/health", timeout=2).read()' 2>/dev/null; then
                            echo "Flask application is responding on port $APP_PORT"
                            exit 0
                        fi
                        sleep 1
                    done
                    cat app.log
                    echo 'Flask application did not become ready.'
                    exit 1
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Checking the deployed app over HTTP.'
                sh '''
                    set -eu
                    "$VENV_DIR/bin/python" - <<'PY'
import urllib.request

url = "http://127.0.0.1:18080/"
with urllib.request.urlopen(url, timeout=5) as response:
    message = response.read().decode("utf-8")
    print(message)
    assert response.status == 200
    assert message == "Hello, Jenkins Multi-Stage Pipeline!"
print("Deployed application verification passed.")
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs for details.'
        }
    }
}